{
  "name": "erp-base-module",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\" index.html README.md package.json eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\" index.html README.md package.json eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.10",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
